# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# ML artifacts — data/ is staged bronze -> silver -> gold, split by dataset
# (md17/md22), see glossary.md section 5. bronze/ is tracked via Git LFS
# (see .gitattributes) - only silver/gold/external stay gitignored until
# their pipelines produce real files. Keep directories + .gitkeep at any
# depth, ignore everything else under them (the "!.../" before "!.../.gitkeep"
# is required so git still traverses into ignored directories).
data/silver/**
data/gold/**
data/external/**
!data/silver/**/
!data/gold/**/
!data/external/**/
!data/**/.gitkeep

# Documented-redundant bronze duplicates (glossary.md section 3) - superseded
# by a canonical .npz already tracked via LFS. Excluded explicitly so a
# broad `git add` never burns scarce LFS storage quota on them.
data/bronze/md17/azobenzene_dft.zip
data/bronze/md17/paracetamol_dft.zip
data/bronze/md17/md17_uracil.zip
data/bronze/md17/ethanol_ccsd_t (1).zip
data/bronze/md22/md22_AT-AT-CG-CG.zip
data/bronze/md22/md22_double-walled_nanotube.zip
experiments/results/*
!experiments/results/.gitkeep
# TensorBoard event files only. experiments/runs/ itself stays tracked: it
# will hold run records for SCRUM-48 provenance.
experiments/runs/**/events.out.tfevents.*
*.pt
*.pth
*.ckpt
checkpoints/
mlruns/
wandb/

# Per-job scratch written by backend/app/services/jobs.py for ad-hoc training
# jobs (POST /jobs/train) - JOB_CONFIGS_DIR / JOB_LOGS_DIR in
# backend/app/core/config.py. Same category as checkpoints/ above: disposable
# outputs of a live job, not part of the committed experiment set. Missing
# from this file was a real bug, not just an oversight - an untracked file
# here makes the whole working tree read as git_dirty=True to
# ml/training/train.py's git_state(), so any training run started while a
# stray job config/log sat here got git_dirty=True baked into its run.json
# forever and was permanently refused by ml/training/benchmark.py's SCRUM-48
# clean-commit gate, with no way to fix it short of retraining.
experiments/configs/jobs/
experiments/job_logs/

# Backend
backend/*.db
backend/**/__pycache__/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Reports
reports/*.pdf
