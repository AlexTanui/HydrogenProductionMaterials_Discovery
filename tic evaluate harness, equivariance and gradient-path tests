[32m+[m[32m        "benchmark_row": {[m
[32m+[m[32m            "phase": checkpoint["phase"],[m
[32m+[m[32m            "model": type(model).__name__,[m
[32m+[m[32m            "energy_mae": record[BENCHMARK_ENERGY_FIELD],[m
[32m+[m[32m            "energy_mae_field": BENCHMARK_ENERGY_FIELD,[m
