[32m+[m[32m        "--split",[m
[32m+[m[32m        default="test",[m
[32m+[m[32m        choices=("train", "val", "test"),[m
[32m+[m[32m        help="default 'test'; anything else is stamped into the output as non-reportable",[m
[32m+[m[32m    )[m
