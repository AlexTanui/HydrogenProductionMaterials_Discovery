[32m+[m[32m            # pass that produces forces, excluding graph construction and[m
[32m+[m[32m            # collation. `eval_wall_clock_s` includes those.[m
[32m+[m[32m            "inference_s_per_config": model_seconds / n_configs,[m
[32m+[m[32m            "wall_clock_s_per_config": wall_seconds / n_configs,[m
[32m+[m[32m            "batch_size": batch_size,[m
[32m+[m[32m            "n_batches": n_batches,[m
[32m+[m[32m            # Training wall-clock is measured by the training loop and[m
[32m+[m[32m            # carried through the checkpoint; it is not re-derivable here.[m
[32m+[m[32m            "train_wall_clock_s": checkpoint.get("train", {}).get("wall_clock_s"),[m
[32m+[m[32m        },[m
[32m+[m[32m        "environment": {[m
[32m+[m[32m            "device": str(torch_device),[m
[32m+[m[32m            "torch": torch.__version__,[m
[32m+[m[32m            "torch_num_threads": torch.get_num_threads(),[m
[32m+[m[32m            "python": platform.python_version(),[m
[32m+[m[32m            "platform": platform.platform(),[m
