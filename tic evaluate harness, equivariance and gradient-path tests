[32m+[m[32m        resolved_gold = ROOT_DIR / resolved_gold[m
[32m+[m[32m    cutoff_radius = float(data_config.get("cutoff_radius", 5.0))[m
[32m+[m[32m    num_rbf = int(data_config.get("num_rbf", 16))[m
[32m+[m
[32m+[m[32m    # The split comes from the gold file's own `{split}_idx`. Contiguous[m
[32m+[m[32m    # trajectory blocks, deterministic, no RNG - never re-derived here.[m
[32m+[m[32m    dataset = MD17Dataset([m
[32m+[m[32m        resolved_gold, split=split, cutoff_radius=cutoff_radius, num_rbf=num_rbf[m
[32m+[m[32m    )[m
[32m+[m[32m    _check_identity(dataset, checkpoint, resolved_gold)[m
[32m+[m[32m    cutoff_warning = _check_cutoff(model, cutoff_radius)[m
[32m+[m
[32m+[m[32m    warnings: list[str] = [][m
[32m+[m[32m    if cutoff_warning:[m
[32m+[m[32m        warnings.append(cutoff_warning)[m
[32m+[m[32m    if split != "test":[m
[32m+[m[32m        warnings.append([m
[32m+[m[32m            f"scored on the {split!r} split, not 'test'. This is not a reportable "[m
[32m+[m[32m            "number for the bake-off table."[m
[32m+[m[32m        )[m
