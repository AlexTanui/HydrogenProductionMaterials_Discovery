[32m+[m[32mdef _resolve_device(name: str) -> torch.device:[m
[32m+[m[32m    if name == "auto":[m
[32m+[m[32m        return torch.device("cuda" if torch.cuda.is_available() else "cpu")[m
[32m+[m[32m    if name == "cuda" and not torch.cuda.is_available():[m
[32m+[m[32m        raise RuntimeError("--device cuda requested but torch.cuda.is_available() is False")[m
[32m+[m[32m    return torch.device(name)[m
[32m+[m
[32m+[m
[32m+[m[32mdef _check_identity(dataset: MD17Dataset, checkpoint: dict[str, Any], gold_path: Path) -> None:[m
[32m+[m[32m    """Refuse to score a checkpoint against data it was not trained on.[m
[32m+[m
[32m+[m[32m    Molecule and theory are the dataset's identity (glossary.md section 5):[m
[32m+[m[32m    ethanol exists at both DFT and CCSD(T) and their absolute energies sit[m
[32m+[m[32m    on different scales, so a mismatch here yields a number that looks fine[m
[32m+[m[32m    and means nothing.[m
[32m+[m[32m    """[m
[32m+[m[32m    trained_on = checkpoint.get("data", {})[m
[32m+[m[32m    for field, actual in (("molecule", dataset.molecule), ("theory", dataset.theory)):[m
[32m+[m[32m        expected = trained_on.get(field)[m
[32m+[m[32m        if expected is not None and str(expected) != str(actual):[m
[32m+[m[32m            raise ValueError([m
[32m+[m[32m                f"checkpoint was trained on {field}={expected!r} but {gold_path.name} "[m
[32m+[m[32m                f"holds {field}={actual!r}. Scoring across molecules or levels of "[m
[32m+[m[32m                "theory produces a believable, meaningless number - pass the "[m
[32m+[m[32m                "matching --gold-path."[m
[32m+[m[32m            )[m
[32m+[m
[32m+[m
[32m+[m[32mdef _check_cutoff(model: torch.nn.Module, cutoff_radius: float) -> Optional[str]:[m
[32m+[m[32m    """Warn if the graph radius differs from the one the model expects.[m
[32m+[m
[32m+[m[32m    Probed generically with `getattr`, so this stays model-agnostic: a model[m
[32m+[m[32m    that does not expose `cutoff_radius` simply skips the check. A mismatch[m
[32m+[m[32m    is not fatal - a model may legitimately apply its own envelope inside a[m
[32m+[m[32m    wider graph - but it silently changes which neighbours contribute, so it[m
[32m+[m[32m    is recorded in the output either way.[m
[32m+[m[32m    """[m
[32m+[m[32m    expected = getattr(model, "cutoff_radius", None)[m
[32m+[m[32m    if expected is None or float(expected) == float(cutoff_radius):[m
[32m+[m[32m        return None[m
[32m+[m[32m    return ([m
[32m+[m[32m        f"graph built at cutoff_radius={cutoff_radius} but the model expects "[m
[32m+[m[32m        f"{float(expected)}; messages beyond the model's radius are dropped by "[m
[32m+[m[32m        "its own cutoff, so this is not the architecture that was trained"[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m
[32m+[m[32mdef evaluate_checkpoint([m
[32m+[m[32m    checkpoint_path: str | Path,[m
[32m+[m[32m    gold_path: Optional[str | Path] = None,[m
[32m+[m[32m    split: str = "test",[m
[32m+[m[32m    batch_size: int = 32,[m
[32m+[m[32m    device: str = "cpu",[m
[32m+[m[32m    num_workers: int = 0,[m
