[32m+[m[32m        "checkpoint": str(checkpoint_path),[m
[32m+[m[32m        "phase": checkpoint["phase"],[m
[32m+[m[32m        "model_config": checkpoint["model_config"],[m
[32m+[m[32m        "n_parameters": int(sum(p.numel() for p in model.parameters())),[m
[32m+[m[32m        "data": {[m
[32m+[m[32m            "gold_path": str(resolved_gold),[m
[32m+[m[32m            "split": split,[m
[32m+[m[32m            "molecule": dataset.molecule,[m
[32m+[m[32m            "theory": dataset.theory,[m
[32m+[m[32m            "cutoff_radius": cutoff_radius,[m
[32m+[m[32m            "num_rbf": num_rbf,[m
[32m+[m[32m            "n_configs": n_configs,[m
[32m+[m[32m            "n_atoms_per_config": int(dataset.z.shape[0]),[m
[32m+[m[32m        },[m
[32m+[m[32m        "metrics": metrics,[m
[32m+[m[32m        "timing": {[m
[32m+[m[32m            "eval_wall_clock_s": wall_seconds,[m
[32m+[m[32m            "model_inference_s": model_seconds,[m
